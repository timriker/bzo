"Upload refused: a replay name is letters, digits, \".\", \"_\" and \"-\"."
msgstr ""
"Nahrání odmítnuto: název záznamu smí obsahovat jen písmena, číslice, \".\", "
"\"_\" a \"-\"."

#: server/messages-operator.cjs:219
msgid "Upload refused: {name} is over {megabytes} MB."
msgstr "Nahrání odmítnuto: {name} má přes {megabytes} MB."

#: server/messages-operator.cjs:225
msgid "Upload refused: {name} is not a bzfs recording ({error})."
msgstr "Nahrání odmítnuto: {name} není záznam bzfs ({error})."

#: server/messages-operator.cjs:229
msgid "Upload refused: {name} is being watched."
msgstr "Nahrání odmítnuto: {name} se právě sleduje."

#: server/messages-operator.cjs:237
msgid "Uploaded replay {name} with {bytes} bytes"
msgstr "Nahrán záznam {name} ({bytes} bajtů)"

#: server/messages-operator.cjs:243
msgid "Upload failed: {error}"
msgstr "Nahrání selhalo: {error}"

#: server/messages-operator.cjs:255
msgid ""
"Save refused: a recording name is letters, digits, \".\", \"_\" and \"-\"."
msgstr ""
"Uložení odmítnuto: název záznamu smí obsahovat jen písmena, číslice, \".\", "
"\"_\" a \"-\"."

#: server/messages-operator.cjs:282
msgid "Delete refused: {name} was not uploaded here."
msgstr "Smazání odmítnuto: {name} sem nebyl nahrán."

#: server/messages-operator.cjs:283
msgid "Delete refused: that was not uploaded here."
msgstr "Smazání odmítnuto: to sem nebylo nahráno."

#: server/messages-operator.cjs:287
msgid "Delete refused: {name} is the map being played."
msgstr "Smazání odmítnuto: {name} je právě hraná mapa."

#: server/messages-operator.cjs:291
msgid "Delete refused: {name} is being watched."
msgstr "Smazání odmítnuto: {name} se právě sleduje."

#: server/messages-operator.cjs:308
msgid "Deleted map {name}"
msgstr "Smazána mapa {name}"

#: server/messages-operator.cjs:308
msgid "Deleted replay {name}"
msgstr "Smazán záznam {name}"

#: server/messages-operator.cjs:313
msgid "Delete failed: {error}"
msgstr "Smazání selhalo: {error}"

#: server/messages-operator.cjs:371
msgid ""
"{server} is no longer in the public list, so {map} is the copy already here "
"({bytes} bytes). It is ready to View now."
msgstr ""
"{server} už není ve veřejném seznamu, takže {map} je zdejší kopie ({bytes} "
"bajtů). Připraveno k zobrazení."

#: server/messages-operator.cjs:374
msgid "Imported {map} from {server} ({bytes} bytes). It is ready to View now."
msgstr ""
"Importováno: {map} ze serveru {server} ({bytes} bajtů). Připraveno k "
"zobrazení."

#: server/messages-play.cjs:1154
msgid "You are unable to begin playing for {seconds} seconds."
msgstr "Hrát můžeš začít až za {seconds} s."

#: server/messages-play.cjs:1192
msgid "Team is not available: {team}"
msgstr "Tým není dostupný: {team}"

#: server/messages-play.cjs:1196
msgid "You stay {team}"
msgstr "Zůstáváš v týmu: {team}"

#: server/messages-play.cjs:1205
msgid "Team is full: {team}"
msgstr "Tým je plný: {team}"

#: server/messages-play.cjs:1210
msgid "You will join {team} when you next spawn"
msgstr "Při příštím respawnu se přidáš k týmu: {team}"

