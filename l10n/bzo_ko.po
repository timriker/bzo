msgstr "업로드 거부: {name} 파일이 {megabytes} MB를 넘어요."

#: server/messages-operator.cjs:227
msgid "Upload refused: {name} is not a bzfs recording ({error})."
msgstr "업로드 거부: {name} 파일은 bzfs 녹화가 아니에요 ({error})."

#: server/messages-operator.cjs:231
msgid "Upload refused: {name} is being watched."
msgstr "업로드 거부: {name} 시청 중이에요."

#: server/messages-operator.cjs:239
msgid "Uploaded replay {name} with {bytes} bytes"
msgstr "리플레이 {name} 업로드됨 ({bytes}바이트)"

#: server/messages-operator.cjs:245
msgid "Upload failed: {error}"
msgstr "업로드 실패: {error}"

#: server/messages-operator.cjs:257
msgid ""
"Save refused: a recording name is letters, digits, \".\", \"_\" and \"-\"."
msgstr ""
"저장 거부: 녹화 이름에는 영문자, 숫자, \".\", \"_\", \"-\"만 쓸 수 있어요."

#: server/messages-operator.cjs:284
msgid "Delete refused: {name} was not uploaded here."
msgstr "삭제 거부: {name} 파일은 여기서 업로드된 게 아니에요."

#: server/messages-operator.cjs:285
msgid "Delete refused: that was not uploaded here."
msgstr "삭제 거부: 여기서 업로드된 게 아니에요."

#: server/messages-operator.cjs:289
msgid "Delete refused: {name} is the map being played."
msgstr "삭제 거부: {name} 맵은 지금 플레이 중이에요."

#: server/messages-operator.cjs:293
msgid "Delete refused: {name} is being watched."
msgstr "삭제 거부: {name} 시청 중이에요."

#: server/messages-operator.cjs:310
msgid "Deleted map {name}"
msgstr "맵 {name} 삭제됨"

#: server/messages-operator.cjs:310
msgid "Deleted replay {name}"
msgstr "리플레이 {name} 삭제됨"

#: server/messages-operator.cjs:315
msgid "Delete failed: {error}"
msgstr "삭제 실패: {error}"

#: server/messages-operator.cjs:373
msgid ""
"{server} is no longer in the public list, so {map} is the copy already here "
"({bytes} bytes). It is ready to View now."
msgstr ""
"{server} 서버가 더 이상 공개 목록에 없어서 {map} 맵은 이미 여기 있는 사본이에"
"요 ({bytes}바이트). 지금 '보기'로 열 수 있어요."

#: server/messages-operator.cjs:376
msgid "Imported {map} from {server} ({bytes} bytes). It is ready to View now."
msgstr ""
"{server}에서 {map} 맵을 가져왔어요 ({bytes}바이트). 지금 '보기'로 열 수 있어"
"요."

#: server/messages-play.cjs:1154
msgid "You are unable to begin playing for {seconds} seconds."
msgstr "{seconds}초 동안 플레이를 시작할 수 없어요."

#: server/messages-play.cjs:1192
msgid "Team is not available: {team}"
msgstr "사용할 수 없는 팀: {team}"

#: server/messages-play.cjs:1196
msgid "You stay {team}"
msgstr "계속 {team}에 있어요"

#: server/messages-play.cjs:1205
msgid "Team is full: {team}"
msgstr "팀이 가득 찼어요: {team}"

#: server/messages-play.cjs:1210
msgid "You will join {team} when you next spawn"
msgstr "다음 스폰 때 {team}에 합류해요"

#~ msgid "This server: {title}."
