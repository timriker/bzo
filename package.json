{
  "name": "bzo",
  "version": "1.0.94",
  "description": "Web based BZFlag like 3D multiplayer tank game, Battlezone Online",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "trap 'exit 0' INT; while true; do nodemon --exitcrash server.js; echo '[dev] server exited, restarting in 2s (Ctrl-C to stop)'; sleep 2; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:server": "node --check server.js",
    "check": "npm run check:server && npm run lint && npm run check:controls-docs && npm run check:shared-pairs && npm run test:volume && npm run test:voice-volume && npm run test:voice-channels && npm run test:input-context && npm run test:pause && npm run test:roam && npm run test:tracks && npm run test:teams && npm run test:team-mode && npm run test:scoreboard && npm run test:commands && npm run test:perf && npm run test:shots && npm run test:flags && npm run test:server-name && npm run test:sessions && npm run test:motion && npm run test:collision && npm run test:capabilities && npm run test:tank-models && npm run test:face-trim",
    "check:controls-docs": "node scripts/check-controls-docs.mjs",
    "check:shared-pairs": "node scripts/check-shared-pairs.mjs",
    "test:input-context": "node scripts/test-input-context.mjs",
    "test:pause": "node scripts/test-pause.mjs",
    "test:volume": "node scripts/test-volume.mjs",
    "test:voice-volume": "node scripts/test-voice-volume.mjs",
    "test:voice-channels": "node scripts/test-voice-channels.mjs",
    "test:roam": "node scripts/test-roam.mjs",
    "test:tracks": "node scripts/test-tracks.mjs",
    "test:teams": "node scripts/test-teams.mjs",
    "test:scoreboard": "node scripts/test-scoreboard.mjs",
    "test:commands": "node scripts/test-commands.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:team-mode": "node scripts/test-team-mode.mjs",
    "test:server-name": "node scripts/test-server-name.mjs",
    "test:sessions": "node scripts/test-sessions.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:shots": "node scripts/test-shots.mjs",
    "test:flags": "node scripts/test-flags.mjs",
    "test:capabilities": "node scripts/test-capabilities.mjs",
    "test:tank-models": "node scripts/test-tank-models.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:check:increment": "node scripts/check-tag-increment.mjs",
    "changelog:extract": "node scripts/extract-changelog.mjs",
    "prepare": "node -e \"const { existsSync } = require('node:fs'); process.exit(existsSync('node_modules/.bin/husky') ? 0 : 1)\" && husky || true",
    "test:collision": "node scripts/test-collision.mjs",
    "test:face-trim": "node scripts/test-face-trim.mjs"
  },
  "keywords": [
    "game",
    "multiplayer",
    "3d",
    "tank"
  ],
  "author": "Tim Riker <timriker@gmail.com>",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.14"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --max-warnings=0"
    ]
  }
}
