{
  "name": "bzo",
  "version": "1.3.24",
  "description": "Web based BZFlag like 3D multiplayer tank game, Battlezone Online",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:watch-args": "node -p \"[...require('./nodemon.json').watch, 'maps/' + (require('./server.json').mapFile || 'bzo.bzw')].map((w) => '--watch ' + w).join(' ')\"",
    "dev": "trap 'exit 0' INT; while true; do nodemon --exitcrash $(npm run --silent dev:watch-args) server.js; echo '[dev] server exited, restarting in 2s (Ctrl-C to stop)'; sleep 2; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:server": "node --check server.js",
    "check": "npm run check:server && npm run check:boot && npm run lint && npm run check:controls-docs && npm run check:shared-pairs && npm run check:markdown && npm run test:volume && npm run test:voice-volume && npm run test:voice-channels && npm run test:input-context && npm run test:pause && npm run test:hunt && npm run test:autopilot && npm run test:bots && npm run test:nav && npm run test:roam && npm run test:tracks && npm run test:teams && npm run test:team-mode && npm run test:scoreboard && npm run test:commands && npm run test:compose && npm run test:chat-cache && npm run test:perf && npm run test:shots && npm run test:flags && npm run test:flag-help && npm run test:server-name && npm run test:sessions && npm run test:server-filter && npm run test:list-server && npm run test:remote-world-import && npm run test:bzfs-session && npm run test:bzfs-replay && npm run test:bzfs-replay-room && npm run test:bzo-recorder && npm run test:lag && npm run test:motion && npm run test:collision && npm run test:trace && npm run test:drive && npm run test:parse-color && npm run test:mesh-seams && npm run test:radar-geometry && npm run test:capabilities && npm run test:tank-models && npm run test:camo && npm run test:face-trim && npm run test:precompress && npm run test:listen-address && npm run test:mesh-face-area && npm run test:unread-options && npm run test:import-sweep && npm run test:guest-checks && npm run test:mesh-arrays && npm run test:bzflag-world && npm run test:world-generator && npm run test:motion-trace",
    "test:bzflag-world": "node scripts/test-bzflag-world.mjs",
    "test:bzfs-replay": "node scripts/test-bzfs-replay.mjs",
    "test:bzfs-replay-room": "node scripts/test-bzfs-replay-room.mjs",
    "test:bzo-recorder": "node scripts/test-bzo-recorder.mjs",
    "test:world-generator": "node scripts/test-world-generator.mjs",
    "test:motion-trace": "node scripts/test-motion-trace.mjs",
    "check:controls-docs": "node scripts/check-controls-docs.mjs",
    "check:shared-pairs": "node scripts/check-shared-pairs.mjs",
    "check:markdown": "node scripts/check-markdown.mjs",
    "test:input-context": "node scripts/test-input-context.mjs",
    "test:pause": "node scripts/test-pause.mjs",
    "test:hunt": "node scripts/test-hunt.mjs",
    "test:autopilot": "node scripts/test-autopilot.mjs",
    "test:bots": "node scripts/test-bots.mjs",
    "test:nav": "node scripts/test-nav.mjs",
    "bench:pilot": "node scripts/bench-pilot.mjs",
    "test:volume": "node scripts/test-volume.mjs",
    "test:voice-volume": "node scripts/test-voice-volume.mjs",
    "test:voice-channels": "node scripts/test-voice-channels.mjs",
    "test:roam": "node scripts/test-roam.mjs",
    "test:tracks": "node scripts/test-tracks.mjs",
    "test:teams": "node scripts/test-teams.mjs",
    "test:scoreboard": "node scripts/test-scoreboard.mjs",
    "test:commands": "node scripts/test-commands.mjs",
    "test:compose": "node scripts/test-compose.mjs",
    "test:chat-cache": "node scripts/test-chat-cache.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:team-mode": "node scripts/test-team-mode.mjs",
    "test:server-name": "node scripts/test-server-name.mjs",
    "test:sessions": "node scripts/test-sessions.mjs",
    "test:server-filter": "node scripts/test-server-filter.mjs",
    "test:list-server": "node scripts/test-list-server.mjs",
    "test:remote-world-import": "node scripts/test-remote-world-import.mjs",
    "test:lag": "node scripts/test-lag.mjs",
    "test:motion": "node scripts/test-motion.mjs",
    "test:radar-geometry": "node scripts/test-radar-geometry.mjs",
    "test:shots": "node scripts/test-shots.mjs",
    "test:flags": "node scripts/test-flags.mjs",
    "test:flag-help": "node scripts/test-flag-help.mjs",
    "test:capabilities": "node scripts/test-capabilities.mjs",
    "test:tank-models": "node scripts/test-tank-models.mjs",
    "test:camo": "node scripts/test-camo.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:check:increment": "node scripts/check-tag-increment.mjs",
    "changelog:extract": "node scripts/extract-changelog.mjs",
    "prepare": "node -e \"const { existsSync } = require('node:fs'); process.exit(existsSync('node_modules/.bin/husky') ? 0 : 1)\" && husky || true",
    "test:mesh-seams": "node scripts/test-mesh-seams.mjs",
    "test:collision": "node scripts/test-collision.mjs",
    "test:face-trim": "node scripts/test-face-trim.mjs",
    "precompress": "node server/precompress.cjs",
    "test:precompress": "node scripts/test-precompress.mjs",
    "test:listen-address": "node scripts/test-listen-address.mjs",
    "test:mesh-face-area": "node scripts/test-mesh-face-area.mjs",
    "test:unread-options": "node scripts/test-unread-options.mjs",
    "test:import-sweep": "node scripts/test-import-sweep.mjs",
    "test:guest-checks": "node scripts/test-guest-checks.mjs",
    "test:mesh-arrays": "node scripts/test-mesh-arrays.mjs",
    "test:trace": "node scripts/test-trace.mjs",
    "test:drive": "node scripts/test-drive.mjs",
    "test:parse-color": "node scripts/test-parse-color.mjs",
    "test:bzfs-session": "node scripts/test-bzfs-session.mjs",
    "check:boot": "node scripts/check-boot.mjs"
  },
  "keywords": [
    "game",
    "multiplayer",
    "3d",
    "tank"
  ],
  "author": "Tim Riker <timriker@gmail.com>",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "three": "^0.185.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.14"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "eslint --max-warnings=0"
    ]
  }
}
