	vertices 4 3 2 1
	phydrv HL1R
	matref L1
endface
face
	vertices 2 6 5 1
	matref L1
endface
face
	vertices 3 7 6 2
	matref L1
endface
face
	vertices 8 7 3 4
	matref L1
endface
face
	vertices 5 8 4 1
	matref L1
endface
face
	vertices 6 7 8 5
	matref null
endface

end

enddef

