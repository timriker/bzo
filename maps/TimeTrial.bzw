# Box Meshes ******************

define boxhl1

mesh

# BoxHL1 Vertices

	vertex 0 0 0
	vertex -0.50000 -0.50000 1.00000
	vertex -0.50000 0.50000 1.00000
	vertex 0.50000 0.50000 1.00000
	vertex 0.50000 -0.50000 1.00000
	vertex -0.50000 -0.50000 0.00000
	vertex -0.50000 0.50000 0.00000
	vertex 0.50000 0.50000 0.00000
	vertex 0.50000 -0.50000 0.00000

# BoxHL1 Faces

