# Time Trial - created by LouMan 2/22/05

metadata
	title Time Trial
	author LouMan
	created 2005-02-22
	sourceurl https://forums.bzflag.org/viewtopic.php?t=3068
endmetadata

# World Options -------------------------------------------------

options
	-set _tankSpeed 35
	# Shots fast enough to catch a racer on the fastest belt (35 + 100): a
	# Guided Missile flies at this speed whatever the tank's. _shotRange stays
	# 350, so they reach no farther.
	-set _shotSpeed 250
	-set _wingsJumpCount 12
	-j
	-ms 1
	# A teammate may be shot -- a BZFlag client joins a team so its waypoint
	# has a team flag to show -- and the one who shoots them does not die
	# for it.
	-tk
	# bzo's own: only a flag carrier fires. -setforced, as a stock bzfs refuses
	# to -set a name it does not know.
	-setforced _shotsNeedFlag 1
	# A flag dropped unused goes home to its zone rather than lying on the
	# track where it fell.
	-set _maxFlagGrabs 1
	-f good
	-f bad
	# Flags may sit on buildings: the track is one.
	-fb
	# Flags may sit on buildings: the track is one.
	-fb
	-sl US 3
	-sl GM 3
	-sl L 3
	-sl SW 3
	-sl F 3
	-sl SB 3
	-sl R 3
	-sl SH 3
	-sl ST 3
	-sl ID 3
end

# Spawn on the track just before the finish line, which racers cross heading
# west; laptimer.cjs times laps across the finishline, through the checkpoints.

zone
	position -50 90 2
	size 25 27 1
	team 0 1 2 3 4
end

finishline
	position -85 90 2
	heading 180
	width 30
	height 10
end

# Flags on the course, three shots each, across the lanes past checkpoint 1.
# Shots need a flag here (_shotsNeedFlag, above).

zone
	position -30 -90 2
	size 8 22 1
	zoneflag US 1
	zoneflag GM 1
	zoneflag L 1
	zoneflag SW 1
	zoneflag F 1
	zoneflag SB 1
	zoneflag R 1
	zoneflag SH 1
	zoneflag ST 1
	zoneflag ID 1
end

# A lap counts only through every checkpoint, in order.

checkpoint
	order 1
	position -75 -90 2
	heading 0
	width 30
	height 10
end

checkpoint
	order 2
	position -440 0 2
	heading 90
	width 30
	height 10
end

checkpoint
	order 3
	position -90 420 2
	heading 0
	width 30
	height 10
end

checkpoint
	order 4
	position 440 -90 2
	heading 270
	width 30
	height 10
end

checkpoint
	order 5
	position 260 -165 2
	heading 90
	width 30
	height 10
end

world
	size 500
end

# Dynamic COlors -----------------------------------------------

dynamicColor
	name redlight
	green limits 0 .5
	green sinusoid 1.5 0 1
	blue limits 0 .5
	blue sinusoid 1.5 0 1
	alpha limits 1 0.25
	alpha sinusoid 1.5 0 1
end

# Straight Line Physics Settings -------------------------------

physics
	name HL1R
	linear 50 0 0
end
physics
	name HL2R
	linear 75 0 0
end
physics
	name HL3R
	linear 100 0 0
end
physics
	name HL1L
	linear -50 0 0
end
physics
	name HL2L
	linear -75 0 0
end
physics
	name HL3L
	linear -100 0 0
end
physics
	name VL1U
	linear 0 50 0
end
physics
	name VL2U
	linear 0 75 0
end
physics
	name VL3U
	linear 0 100 0
end
physics
	name VL1D
	linear 0 -50 0
end
physics
	name VL2D
	linear 0 -75 0
end
physics
	name VL3D
	linear 0 -100 0
end

# Texture Matrices ---------------------------------------------

textureMatrix
	name BricksRotated
	fixedspin 90
end
textureMatrix
	name FlagBanner1
	fixedshift .13 -.032
	fixedscale 0.25 0.1875
end
textureMatrix
	name FlagBanner2
	fixedspin 90
	fixedshift -.594 0.127
	fixedscale 0.25 0.1875
end
textureMatrix
	name Sign1
	fixedspin -90
	fixedshift 0.41 3.25
	fixedscale 7.8 2.4
end
textureMatrix
	name Sign2
	fixedspin 180
	fixedshift 3.25 0.6
	fixedscale 7.8 2.4
end
textureMatrix
	name winnerscircle
	fixedspin 180
	fixedscale 1.1 1.1
end

# Materials ----------------------------------------------------

material
	name Bricks
	texture boxwall
end
material
	name L1
	texture roof
	color gray20
end
material
	name L2
	texture roof
	color gray25
end
material
	name L3
	texture roof
	color gray30
end
material
	name Roof
	texture roof
end
material
	name winnerscircle
	texture flag
	color gray25
	texmat winnerscircle
end
material
	name BricksRotated
	texture boxwall
	texmat BricksRotated
end
material
	name FlagPole
	texture roof
	diffuse .7 .7 1
end
material
	name FlagBanner1
	texture flag
	texmat FlagBanner1
	color yellow
end
material
	name FlagBanner2
	texture flag
	texmat FlagBanner2
	color yellow
end
material
	name null
	notextures
	diffuse 0 0 0 0
end
material
	name Beams
	texture roof
	color gray50
end
material
	name blk
	notextures
	diffuse 0 0 0 0.5
end
material
	name wht
	notextures
	diffuse 1 1 1 0.5
end
material
	name Sign1
	texture title
	texmat Sign1
end
material
	name Sign2
	texture title
	texmat Sign2
end
material
	name Tower
	texture roof
	color gray85
end
material
	name Tower2
	texture roof
	color SlateBlue
end
material
	name Tower3
	texture roof
	diffuse .1 .1 .1 .95
end
material
	name Light1
	notextures
	dyncol redlight
	emission red
end

