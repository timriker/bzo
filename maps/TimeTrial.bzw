# Checker Mesh ******************

define checker

mesh

drivethrough

# Checker Vertices

	vertex 2.5 2.5 0.0
	vertex 2.5 -2.5 0.0
	vertex -2.5 -2.5 0.0
	vertex -2.5 2.5 0.0

# Checker Faces

face
	vertices 3 2 1 0
endface

end

