# Tricolor version 2
# A CTF map for three teams, each with a castle. Symmetric.
# Copyright 2009 - The Purple Panzer released as Public Domain
# https://www.bentz-engineering.com/bz/MyMaps.html

options
  -set _explodeTime 2
  -set _latitude 41.341799
  -set _longitude -71.938799
  -set _rainRoofs 2
  -set _wingsJumpCount 10
  -set _mGunAdLife 0.8
  -set _mGunAdRate 30
  -set _mGunAdVel 10
  -set _wingsJumpCount 12
  -set _noClimb 0
  -set _wallHeight 0
  -set _drawClouds 0
  -set _drawGroundLights 0
  -set _wallHeight 0
end
world
  size 430
noWalls
end
physics
  name Pyrs
  death You've gone too far; you're dead.
end
####################### Start of include file includes/spawnpod.txt#######################
material
  name PyrWalls
  diffuse 0.75 0.75 0.75 0.75
  addtexture pyrwall.png
end


define spawnpod
  mesh
  # faces = 8
  # checks = 0
  # vertices = 5
  # normals = 0
  # texcoords = 0
  # mins = -1 -1 0
  # maxs = 1 1 1
    driveThrough
    vertex 0.00000000 0.00000000 1.00000000
    vertex -1.00000000 -1.00000000 0.00000000
    vertex -1.00000000 1.00000000 0.00000000
    vertex 1.00000000 1.00000000 0.00000000
    vertex 1.00000000 -1.00000000 0.00000000
    face
      vertices 0 1 2
      matref PyrWalls
      passable
    endface
    face
      vertices 0 2 3
      matref PyrWalls
      passable
    endface
    face
      vertices 0 3 4
      matref PyrWalls
      passable
    endface
    face
      vertices 0 4 1
      matref PyrWalls
      passable
    endface
    face
      vertices 2 1 0
      matref PyrWalls
    endface
    face
      vertices 3 2 0
      matref PyrWalls
    endface
    face
      vertices 4 3 0
      matref PyrWalls
    endface
    face
      vertices 1 4 0
      matref PyrWalls
    endface
  end
enddef

#######################   End of include file includes/spawnpod.txt#######################
