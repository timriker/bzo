# This map puts three of each type of flag in its own zone,
# making them easy to find for testing purposes.

options
  -ms 3
  -sa
  -set _maxFlagGrabs 1
  -set _wingsJumpCount 3
  # Teams, so the flags that only mean something between them -- team flags and
  # their capture, Genocide, Masquerade, Colorblindness, a shock wave or a
  # steamroller taking a team mate with it -- have somebody to mean it against.
  # Green and purple are the two with bases; red and blue are closed, because on
  # a map this size two more bases would sit empty. Rogue stays open for testing
  # a tank that is on nobody's side. `-mp` counts run rogue, red, green, blue,
  # purple, observer, and a zero closes a team.
  -c
  -mp 10,0,10,0,10,10
  -srvmsg "Flag names progress alphabetically clockwise from the north."
  -srvmsg "Good flags are on the inner loop.  Bad flags are on the outer loop."
  -srvmsg "Green base is east, purple base is west."
  -srvmsg "Self-destruct may be the easiest way to drop a Bouncy flag."
	# A bad flag also falls off after this many kills.
	-sw 1
end

# 160 rather than the 120 this started at, purely to make room outside the flag
# rings for the two bases: the rings themselves stay at 40 and 80, so the only
# thing that grew is the empty ground past them.
world
  size 160
end

# A platform with room to drive on, for testing edges. 40x40 across the top at
# a height of 10, reached by the teleporter pair below rather than by jumping,
# so edge behaviour can be tested without a JP or WG flag in hand.
box
  position 80 -80 0
  size 20 20 10
end

pyramid
  position -80 80 0
  size 20 20 30
end

# A row of pyramids from nearly flat to nearly vertical, on the empty ground
# south of the flag rings, so what a slope does to a tank can be driven rather
# than argued about. All five share a 40-unit base, so only the height changes
# and the slope is the only variable.
#
# The answer is the same at every slope, which is the point of the row: BZFlag
# holds a tank on any pyramid face and drives it up none of them. A pyramid's
# hit normal always tilts upward -- `width / hypot(height, width)`, which is
# 0.98 on the shallowest of these and 0.32 on the steepest -- and
# doUpdateMotion reads a landing off any normal above 0.001
# (LocalPlayer.cxx:617). It bumps a tank up a ledge only where the obstacle
# `isFlatTop()`, which for a pyramid is `flipz`, so the four upright ones stop a
# tank at their base however gentle they look. Drop onto one and you stay where
# you land, including on the point.
pyramid
  name slope_02
  position -110 -120 0
  size 20 20 4
end
pyramid
  name slope_06
  position -60 -120 0
  size 20 20 12
end
pyramid
  name slope_15
  position -10 -120 0
  size 20 20 30
end
pyramid
  name slope_30
  position 40 -120 0
  size 20 20 60
end

# The flat-topped one, which is the shape a tank is meant to drive on: `flipz`
# is upstream's ZFlip, `isFlatTop()` is true for it, and its widest
# cross-section is the plateau rather than the base.
pyramid
  name plateau
  position 90 -120 0
  size 20 20 10
  flipz
end

# The ground end of the pair. Both teleporters give no size or border, so both
# take CustomGate's defaults -- half width 0.56, half breadth 4.48, height
# 20.16, border 1.12 -- which is also the path a map exercises by saying nothing.
teleporter portal
  position 35 -80 0
  rotation 90
end

# And the platform end, in the middle of the roof.
teleporter roof
  position 80 -80 10
  rotation 90
end

# Linked both ways round on both faces, so either face of either teleporter
# takes you to the other one and you can always get back. Without these each
# face would fall through to the opposite face of its own teleporter, which is
# upstream's rule for an unlinked face and makes a doorway rather than a pair.
link
  from portal:f
  to   roof:b
end

link
  from roof:b
  to   portal:f
end

link
  from portal:b
  to   roof:f
end

link
  from roof:f
  to   portal:b
end

# The two bases, flat on the ground rather than raised on anything, so a tank
# drives onto one instead of having to jump for it -- `size` gives no height at
# all, which is upstream's CustomBase default and makes a base a painted square
# a tank drives over and a shot flies across.
#
# Out at 130 with a 40x40 top, which clears the outer flag ring at 80 by fifty
# units and leaves thirty to the world edge. `color` is a BZFlag team index: 2
# is green, 4 is purple.
base
  name e_g_base
  position 130 0 0
  size 20 20 0
  color 2
end

base
  name w_p_base
  position -130 0 0
  size 20 20 0
  color 4
end

# Third-person camera geometry, out on the empty north-east ground where it is
# clear of both flag rings and of everything else the map tests.
#
# The octagon is the four boxes hix carries under its diagonal walls: one
# position, one size, rotations 45 degrees apart. The half-width is the
# half-depth times (1 + sqrt 2), which is what puts each plank's corners exactly
# on its neighbour's -- 19.313708499 is 8.0 * (1 + sqrt 2). What it is here for
# is the overlap: a tank, or a chase camera, near the middle of this is inside
# as many as four obstacles at once, and the count falls to three and then one
# on the way out to the rim.
box
  name oct_0
  position 100 100 0
  rotation 0
  size 19.313708499 8 15
end

box
  name oct_45
  position 100 100 0
  rotation 45
  size 19.313708499 8 15
end

box
  name oct_90
  position 100 100 0
  rotation 90
  size 19.313708499 8 15
end

box
  name oct_135
  position 100 100 0
  rotation 135
  size 19.313708499 8 15
end

# And a wall of the same thickness as hix's diagonal upper walls, 0.5 half-depth
# for a metre across, sixty long and sixteen tall. A metre is thinner than the
# chase camera's twelve-unit trail, so backing into this puts the eye out beyond
# the far face rather than inside the wall -- which is the case a thick obstacle
# does not reach. Twenty units south of the octagon, with room to turn between
# them.
box
  name thin_wall
  position 100 60 0
  rotation 0
  size 30 0.5 16
end

