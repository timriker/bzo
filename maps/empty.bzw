define BillboardFight
  group BillboardRedTank
    shift -9 0 0
  end
  group BillboardBlueTank
    shift 9 0 0
    rotation 180
  end
  mesh
    name billboard_shot1
    vertex -3.3 0 0.73
    vertex -1.7 0 0.73
    vertex -1.7 0 2.33
    vertex -3.3 0 2.33
    texcoord 0 0
    texcoord 1 0
    texcoord 1 1
    texcoord 0 1
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_shot1
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_shot1
    endface
  end
  mesh
    name billboard_shot2
    vertex -0.3 0 0.73
    vertex 1.3 0 0.73
    vertex 1.3 0 2.33
    vertex -0.3 0 2.33
    texcoord 0 0
    texcoord 1 0
    texcoord 1 1
    texcoord 0 1
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_shot2
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_shot2
    endface
  end
  mesh
    name billboard_shot3
    vertex 2.7 0 0.73
    vertex 4.3 0 0.73
    vertex 4.3 0 2.33
    vertex 2.7 0 2.33
    texcoord 0 0
    texcoord 1 0
    texcoord 1 1
    texcoord 0 1
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_shot3
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_shot3
    endface
  end
  mesh
    name billboard_flash
    vertex 7.5 -1.6 0
    vertex 10.5 -1.6 0
    vertex 10.5 -1.6 3
    vertex 7.5 -1.6 3
    texcoord 0.25 0.125
    texcoord 0.375 0.125
    texcoord 0.375 0.25
    texcoord 0.25 0.25
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_flash
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_flash
    endface
  end
  mesh
    name billboard_fireball
    vertex 6 -1.6 0
    vertex 12 -1.6 0
    vertex 12 -1.6 6
    vertex 6 -1.6 6
    texcoord 0.25 0.375
    texcoord 0.375 0.375
    texcoord 0.375 0.5
    texcoord 0.25 0.5
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_fireball
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_fireball
    endface
  end
  mesh
    name billboard_fire
    vertex 5.5 -1.6 0
    vertex 12.5 -1.6 0
    vertex 12.5 -1.6 7
    vertex 5.5 -1.6 7
    texcoord 0.75 0.5
    texcoord 0.875 0.5
    texcoord 0.875 0.625
    texcoord 0.75 0.625
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_fire
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_fire
    endface
  end
  mesh
    name billboard_smoke
    vertex 5 -1.6 0.5
    vertex 13 -1.6 0.5
    vertex 13 -1.6 8.5
    vertex 5 -1.6 8.5
    texcoord 0.25 0.75
    texcoord 0.375 0.75
    texcoord 0.375 0.875
    texcoord 0.25 0.875
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_smoke
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_smoke
    endface
  end
  mesh
    name billboard_smoke2
    vertex 5 -1.6 1.5
    vertex 13 -1.6 1.5
    vertex 13 -1.6 9.5
    vertex 5 -1.6 9.5
    texcoord 0.5 0.875
    texcoord 0.625 0.875
    texcoord 0.625 1
    texcoord 0.5 1
    passable
    face
      vertices 0 1 2 3
      texcoords 0 1 2 3
      matref billboard_smoke2
    endface
    face #backside
      vertices 1 0 3 2
      texcoords 1 0 3 2
      matref billboard_smoke2
    endface
  end
  meshbox
    name billboard_board
    position 0 2.75 0
    size 14 0.25 12.6
    matref billboard_board
  end
  # 0.2 clear of the board: at 0.02 bzo's depth test hid it behind the board,
  # though the native client drew it.
  mesh
    name billboard_poster
    vertex -12 2.3 4.6
    vertex 12 2.3 4.6
