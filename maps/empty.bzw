#

metadata
  title Empty
  author Tim Riker <timriker@gmail.com>
  license AGPL-3.0-only
  description An empty world for testing, with a billboard showing the client's title and version.
endmetadata

world
  name test
  size 40.0
  flagHeight 0.0
end

# A shot and a kill, played on a loop by bundled textures alone, so a native
# BZFlag client draws it too. A red tank fires at a blue one; the shot
# crosses in three frames, the blue tank vanishes in the explosion and comes
# back when the loop restarts.
#
# Every frame is its own passable quad whose `dynamicColor` alpha runs a
# `sequence`: twelve steps of 0.3 s, 3.6 s round, each frame on (2) for its
# own step and off (0) for the rest. All share the one game clock, so exactly
# one frame shows at a time. A sequence of only 0 and 2 with `limits 0 1` is
# drawn as shown or hidden, never half see-through (`DynamicColor::finalize`).
#
# The shot is `red_bolt`; the explosion frames are cells of `explode1`, an
# 8 by 8 sheet whose frame 0 is the bottom-left cell, picked by each quad's
# texcoords. The frames are flat, so seen edge-on from east or west the loop
# is a line.
#
# The tanks are the stock model `scripts/gen-tank-bzw.mjs` writes, still
# (`--angvel 0`) and one define per colour: a group's `matref` does not reach
# a `drawInfo`, so the colour has to be in the define. No faces, so a tank
# drives through them.

dynamicColor
  name billboard_blue_alive
  alpha limits 0 1
  alpha sequence 0.3 0 2 2 2 2 2 2 2 2 0 0 0 0
end

material
  name billboard_red_tank
  texture red_tank
  diffuse 1 1 1 1
end

material
  name billboard_blue_tank
  texture blue_tank
  diffuse 1 1 1 1
  dyncol billboard_blue_alive
end

# The board the scene plays in front of, and the lamps along its top edge.
# A lamp's light is drawn rather than cast, as Rat's Nest's wall lights are:
# an unlit, see-through beam widening down to the ground. The beam's fade is
# `blend_flash`, the client's own soft band, from its peak at the lamp to its
# clear edge at the ground.
material
  name billboard_board
  diffuse 0.12 0.12 0.14 1
end

# The poster is the client's own `title`, the image its title screen shows,
# so every client puts up its own version's.
material
  name billboard_poster
  texture title
end

material
  name billboard_lamp
  diffuse 0.2 0.2 0.2 1
end

material
  name billboard_lens
  diffuse 1 0.95 0.75 1
  nolighting
end

material
  name billboard_beam
  texture blend_flash
  diffuse 1 0.95 0.75 0.5
  # No alpha test, as upstream draws it: the fade runs out to clear.
  alphathresh 0.001
  nolighting
  noshadow
  noradar
  noculling
end

dynamicColor
  name billboard_shot1
  alpha limits 0 1
  alpha sequence 0.3 0 0 0 0 0 2 0 0 0 0 0 0 0
end

material
  name billboard_shot1
  texture red_bolt
  dyncol billboard_shot1
  nolighting
  noshadow
  noradar
end

dynamicColor
  name billboard_shot2
  alpha limits 0 1
  alpha sequence 0.3 0 0 0 0 0 0 2 0 0 0 0 0 0
end

material
  name billboard_shot2
