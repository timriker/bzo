    endface
    face
      vertices 6 7 3 2
      texcoords 0 1 2 3
    endface
    face
      vertices 7 4 0 3
      texcoords 0 1 2 3
    endface
  end
  meshbox
    name billboard_lamp_arm_middle
    position 0 2.2 12.1
    size 0.15 0.3 0.15
    matref billboard_lamp
  end
  meshbox
    name billboard_lamp_middle
    position 0 1.6 11.8
    size 0.6 0.4 0.5
    matref billboard_lamp
  end
  meshbox
    name billboard_lens_middle
    position 0 1.6 11.74
    size 0.5 0.3 0.06
    matref billboard_lens
  end
  mesh
    name billboard_beam_middle
    vertex -0.5 1.3 11.7
    vertex 0.5 1.3 11.7
    vertex 0.5 1.9 11.7
    vertex -0.5 1.9 11.7
    vertex -4.5 -5 0.02
    vertex 4.5 -5 0.02
    vertex 4.5 2.4 0.02
    vertex -4.5 2.4 0.02
    texcoord 0 1
    texcoord 1 1
    texcoord 1 0.5
    texcoord 0 0.5
    matref billboard_beam
    passable
    face
      vertices 4 5 1 0
      texcoords 0 1 2 3
    endface
    face
      vertices 5 6 2 1
      texcoords 0 1 2 3
    endface
    face
      vertices 6 7 3 2
      texcoords 0 1 2 3
    endface
    face
      vertices 7 4 0 3
      texcoords 0 1 2 3
    endface
  end
  meshbox
    name billboard_lamp_arm_blue
    position 9 2.2 12.1
    size 0.15 0.3 0.15
    matref billboard_lamp
  end
  meshbox
    name billboard_lamp_blue
    position 9 1.6 11.8
    size 0.6 0.4 0.5
    matref billboard_lamp
  end
  meshbox
    name billboard_lens_blue
    position 9 1.6 11.74
    size 0.5 0.3 0.06
    matref billboard_lens
  end
  mesh
    name billboard_beam_blue
    vertex 8.5 1.3 11.7
    vertex 9.5 1.3 11.7
    vertex 9.5 1.9 11.7
    vertex 8.5 1.9 11.7
    vertex 4.5 -5 0.02
    vertex 13.5 -5 0.02
    vertex 13.5 2.4 0.02
    vertex 4.5 2.4 0.02
    texcoord 0 1
    texcoord 1 1
    texcoord 1 0.5
    texcoord 0 0.5
    matref billboard_beam
    passable
    face
      vertices 4 5 1 0
      texcoords 0 1 2 3
    endface
    face
      vertices 5 6 2 1
      texcoords 0 1 2 3
    endface
    face
      vertices 6 7 3 2
      texcoords 0 1 2 3
    endface
    face
      vertices 7 4 0 3
      texcoords 0 1 2 3
    endface
  end
enddef

# Against the north wall, facing the centre.
group BillboardFight
  shift 0 37 0
end
