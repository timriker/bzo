end

dynamicColor
  name billboard_flash
  alpha limits 0 1
  alpha sequence 0.3 0 0 0 0 0 0 0 0 2 0 0 0 0
end

material
  name billboard_flash
  texture explode1
  dyncol billboard_flash
  nolighting
  noshadow
  noradar
end

dynamicColor
  name billboard_fireball
  alpha limits 0 1
  alpha sequence 0.3 0 0 0 0 0 0 0 0 0 2 0 0 0
end

