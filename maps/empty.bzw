  meshbox
    name billboard_lamp_arm_red
    position -9 2.2 12.1
    size 0.15 0.3 0.15
    matref billboard_lamp
  end
  meshbox
    name billboard_lamp_red
    position -9 1.6 11.8
    size 0.6 0.4 0.5
