# The four bases, one on each compass point at radius 100, flat on the
# ground as `flagbuffet.bzw`'s are. Colour follows `hix.bzw`'s convention:
# north red, east green, south blue, west purple.
base
  name n_red_base
  position 0 100 0
  size 20 20 0
  color 1
end

base
  name e_green_base
  position 100 0 0
  size 20 20 0
  color 2
end

base
  name s_blue_base
  position 0 -100 0
  size 20 20 0
  color 3
end

base
  name w_purple_base
  position -100 0 0
  size 20 20 0
  color 4
end

# Four obstacle tests, one per corner, clear of the rings and the bases.

# North-east: the octagon and a thin wall, `hix.bzw`'s own third-person
# camera geometry, also carried in `flagbuffet.bzw`. Four planks at one
# position, 45 degrees apart; the half-width is the half-depth times
# (1 + sqrt 2), which is what puts each plank's corners exactly on its
# neighbour's. Near the middle a tank or a chase camera is inside as many as
# four obstacles at once.
box
  name oct_0
  position 105 105 0
  rotation 0
  size 14.485281374 6 12
end

box
  name oct_45
  position 105 105 0
  rotation 45
  size 14.485281374 6 12
end

box
  name oct_90
  position 105 105 0
  rotation 90
  size 14.485281374 6 12
end

box
  name oct_135
  position 105 105 0
  rotation 135
  size 14.485281374 6 12
end

# A wall a metre thick, thinner than the chase camera's trail, so backing
# into it puts the eye out beyond the far face instead of inside the wall.
box
  name thin_wall
  position 105 65 0
  rotation 0
  size 15 0.5 10
end

# North-west: two overlap tests. A pyramid, a box and a flipped pyramid
# stand edge to edge -- climb the first, cross the flat top of the second,
# and the third flares out above you rather than tapering to a point. Below
# them, three pyramids share one footprint at three different sizes, so a
# tank can only ever be resting on the outermost one still taller than it.
pyramid
  name overlap_up
  position -95 83 0
  rotation 0
  size 18.0 9.0 10.0
end

box
  name overlap_mid
  position -95 95 0
  rotation 0
  size 18.0 3.0 10.0
end

pyramid
  name overlap_down
  position -95 107 0
  rotation 0
  size 18.0 9.0 -10.0
end

pyramid
  name nest_base
  position -95 55 0
  rotation 0
  size 10.0 10.0 3.0
end

pyramid
  name nest_mid
  position -95 55 0
  rotation 0
  size 5.0 5.0 7.0
end

pyramid
  name nest_top
  position -95 55 0
  rotation 0
  size 2.0 2.0 12.0
end

# South-east: step and bump height tests, and the passability keyword row.
#
# Three steps a quarter unit apart, each half a tank-length wide, so the
# climb from one to the next can be driven rather than argued about.
box
  name step_low
  position 80 -90 0
  rotation 0
  size 8.0 8.0 0.25
end

box
  name step_medium
  position 88 -90 0.25
  rotation 0
  size 8.0 8.0 0.25
end

box
  name step_high
  position 96 -90 0.5
  rotation 0
  size 8.0 8.0 0.25
end

# The same quarter-unit rise, stacked ten times on itself, to test whether
# many small rises stay climbable even when the outside looks like one tall
# wall.
box
  name stack1
  position 80 -65 0
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack2
  position 80 -65 0.25
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack3
  position 80 -65 0.50
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack4
  position 80 -65 0.75
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack5
  position 80 -65 1.00
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack6
  position 80 -65 1.25
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack7
  position 80 -65 1.50
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack8
  position 80 -65 1.75
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack9
  position 80 -65 2.00
  rotation 0
  size 8.0 8.0 0.25
end

box
  name stack10
  position 80 -65 2.25
  rotation 0
  size 8.0 8.0 0.25
end

# Passability keywords, one box each, named for what it is since bzo draws
# an obstacle's name as its debug label. `solid` is the control; each of the
# other four differs from it in exactly one way.
box
  name solid
  position 65 -125 0
  rotation 0
  size 6.0 6.0 5.0
end

box
  name drivethrough
  position 79 -125 0
  rotation 0
  size 6.0 6.0 5.0
  drivethrough
end

box
  name shootthrough
  position 93 -125 0
  rotation 0
  size 6.0 6.0 5.0
  shootthrough
end

box
  name passable
  position 107 -125 0
  rotation 0
  size 6.0 6.0 5.0
  passable
end

box
  name ricochet
  position 121 -125 0
  rotation 0
  size 6.0 6.0 5.0
  RicoChet
end

# `pos`/`rot`, `WorldFileLocation::read`'s aliases of `position`/`rotation`,
# and `flipz`, the other way of saying a negative size height.
box
  name aliased
  pos 65 -108 0
  rot 45.0
  size 6.0 6.0 5.0
end

pyramid
  name flipped
  position 79 -108 0
  FlipZ
  rotation 0
  size 6.0 6.0 5.0
end

# South-west: the same teleporter pair `flagbuffet.bzw` carries, and two
# overhangs to jump into. `doUpdateMotion` zeroes a tank's rise the instant
# it meets a surface above it (see AGENTS.md), so driving under either of
# these and jumping is what that rule looks like from the driver's seat --
# the tank falls back to the ground rather than sticking to the underside.
box
  name platform
  position -95 -95 0
  size 10 10 8
end

teleporter portal
  position -120 -95 0
  rotation 90
end

teleporter roof
  position -95 -95 8
  rotation 90
end

link
  from portal:f
  to   roof:b
end

link
  from roof:b
  to   portal:f
end

link
  from portal:b
  to   roof:f
end

link
  from roof:f
  to   portal:b
end

# A flat ceiling to jump into: four units of clearance, easily driven under,
# and well inside a jump's apex.
box
  name jump_box
  position -115 -70 4
  size 6 6 3
end

# The same test against a pyramid's base rather than a box's underside --
# raised clear of the ground, so the base is a real face rather than the one
# `public/face-trim.mjs` would otherwise leave out.
pyramid
  name jump_pyramid
  position -95 -70 4
  size 6 6 4
end
