# The default world: every flag reachable within a short walk of the centre,
# a base on each compass point, and a sample of bzo's obstacle geometry tests
# in the four corners.
#
# `ID` sits alone at the centre. The ring immediately around it is every bad
# flag, clustered by what they do to a tank rather than laid out
# alphabetically, so a `-sa`/`-sw` server exercises one theme at a time. The
# outer ring is every good flag, alphabetically clockwise from north.

options
	# Team play, so the four coloured bases below are capture targets.
	-c
	# Per-team player limits, in BZFlag's team order:
	# rogue, observer, red, green, blue, purple.
	-mp 10,10,10,10,10,10
  # Tanks may jump
  -j
  # Five shots in the air at once
  -ms 5
  # How many times `WG` Wings may flap before it needs the ground again.
  -set _wingsJumpCount 4
  # keep flags only in their spawn zones
  -set _maxFlagGrabs 1
  -srvmsg "Bad flags ring the centre; good flags ring those."
  -srvmsg "Team bases sit on the compass points; test geometry is in the corners."
  # bad flag falls off in this many seconds
  -st 30
  # bad flag also falls off after this many kills.
  -sw 1
  # antidote flag for whoever is carrying a bad one
  -sa
end

world
  size 140
end

# The centre. Every flag here is `zoneflag`d with a count of 3
# enough copies that a grab does not empty the pad before
# the next respawn cycle finds it again.
zone
  position 0 0 0
  size 1 1 0
  zoneflag ID 3
end

box
  name ID_Identify
  position 0 0 0
  size 1 1 0
  passable
end

# The bad ring, radius 25. Four groups, one per compass edge, each named for
# what it takes away from a tank rather than what letter it starts with:
#
#   north  steering reversed or locked to one direction
#   east   can't stop -- bouncing, firing, or accelerating
#   south  senses taken away -- sight, colour, radar
#   west   the tank itself grows or grounds
#
# `WA` sits with the sight group: bzo never spawns it (see docs/flags.md),
# but the zone and its pad are real, so this map plays on bzfs.

# North: steering.
zone
  position -20 25 0
  size 1 1 0
  zoneflag FO 3
end
box
  name FO_Forward_Only
  position -20 25 0
  size 1 1 0.02
  color 1.0 0.62745 0.12549
  passable
end

zone
  position -10 25 0
  size 1 1 0
  zoneflag LT 3
end
box
  name LT_Left_Turn_Only
  position -10 25 0
  size 1 1 0.02
  color 1.0 0.62745 0.12549
  passable
end

zone
  position 0 25 0
  size 1 1 0
  zoneflag RC 3
end
box
  name RC_ReverseControls
  position 0 25 0
  size 1 1 0.02
  color 1.0 0.62745 0.12549
  passable
end

zone
  position 10 25 0
  size 1 1 0
  zoneflag RO 3
end
box
  name RO_ReverseOnly
  position 10 25 0
  size 1 1 0.02
  color 1.0 0.62745 0.12549
  passable
end

zone
  position 20 25 0
  size 1 1 0
  zoneflag RT 3
end
box
  name RT_Right_Turn_Only
  position 20 25 0
  size 1 1 0.02
  color 1.0 0.62745 0.12549
  passable
end

