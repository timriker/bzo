	box
		name wallend2
		position 280.0 280.0 0.0
		rotation 0.0
		size     30.0 30.0 15.0
		top matref concrete
		sides matref industrial
	end

	# closest to center support
	group support
		name in
		position 140.0 140.0 0.0
		rotation 0.0
	end
	# farthest from center support
	group support
		name out
		position 220.0 220.0 0.0
		rotation 0.0
	end

	# teleporter pair for this diagonal arm, at the tip of
	# the ne instance's own corner -- the group's rotation carries it to
	# each other corner exactly the way it already does for oct/xwall/the
	# access boxes.
	teleporter
		name tele_low
		position     390.0 390.0 0.0
		rotation     45.0
		size         0.56  4.48  27.7
		border       1.12
	end
	teleporter
		name tele_high
		position     390.0 390.0 30.0
		rotation     45.0
		size         0.56  4.48  15.0
		border       1.12
	end

	# One diagonal half of a crossbar walkway -- from this corner's own end
	# in to the exact map centre. The group's own rotation is what
	# reconstructs a full bridge: this instance plus its `sw` mirror is the
	# whole ne-sw span, and `nw`/`se` is the whole nw-se span, the same
	# trick the teleporter pair above already uses. Still a
	# hand-authored `mesh` rather than a `meshbox`, for the same UV-stretch
	# reason as `walk`/`plat1` -- every wall's texcoord is its own local
	# coordinate divided by 8, every top/bottom's by 2
	# (`render.js`'s `BOX_TEXTURE_SCALES`).
	mesh
		name xbar
		vertex 391.737157 386.080303 29
		vertex 386.080303 391.737157 29
		vertex 4 9.656854 29
		vertex 9.656854 4 29
		vertex 391.737157 386.080303 30
		vertex 386.080303 391.737157 30
		vertex 4 9.656854 30
		vertex 9.656854 4 30
		texcoord -2 -275
		texcoord -2 -4.828427
		texcoord 2 -4.828427
		texcoord 2 -275
		texcoord -2 -275
		texcoord 2 -275
		texcoord 2 -4.828427
		texcoord -2 -4.828427
		texcoord -0.5 0
		texcoord 0.5 0
		texcoord 0.5 0.125
		texcoord -0.5 0.125
		texcoord -68.75 0
		texcoord -1.207107 0
		texcoord -1.207107 0.125
		texcoord -68.75 0.125
		texcoord -0.5 0
		texcoord 0.5 0
		texcoord 0.5 0.125
		texcoord -0.5 0.125
		texcoord 1.207107 0
		texcoord -68.75 0
		texcoord -68.75 0.125
		texcoord 1.207107 0.125
		face
			vertices 0 3 2 1
			texcoords 0 1 2 3
			matref seethrough
		endface
		face
			vertices 4 5 6 7
			texcoords 4 5 6 7
			matref concrete
		endface
		face
			vertices 0 1 5 4
			texcoords 8 9 10 11
			matref industrial
		endface
		face
			vertices 1 2 6 5
			texcoords 12 13 14 15
			texture caution
		endface
		face
			vertices 2 3 7 6
			texcoords 16 17 18 19
			matref industrial
		endface
		face
			vertices 3 0 4 7
			texcoords 20 21 22 23
			texture caution
		endface
	end
enddef

group diag_quadrant
	name ne
	position 0.0 0.0 0.0
	rotation 0.0
end
group diag_quadrant
	name nw
	position 0.0 0.0 0.0
	rotation 90.0
end
group diag_quadrant
	name sw
	position 0.0 0.0 0.0
	rotation 180.0
end
group diag_quadrant
	name se
	position 0.0 0.0 0.0
	rotation 270.0
end

# The other quarter-turn symmetry the map carries -- the guard post, edge
# walkway, two access boxes, the middle box and the pyramid trusses standing
# under a base -- defined once at the east side's own coordinates, placed
# four times below the same way `diag_quadrant` is. The base itself is not a
# member here: each one needs its own team colour (see `base`, below), and a
# `group` instance has no way to vary a base's `color` per placement --
# `matref`/`addtexture` on a `group` line only ever reaches a mesh member's
# faces (see docs/bzw.md, "Groups"), never a base's own team field. Verified
# against the file's own e_/n_/w_/s_ numbers the same way as above.
define cardinal_quadrant
	box
		name guard
		position 392.5 0.0 29.0
		rotation 0.0
		size     7.5 7.5 16.0
		top matref concrete
		sides matref industrial
	end
	# walkway on the edge
	# overlaps the platforms to prevent flag hiding
	# Same reasoning as `plat1` above -- a hand-authored `mesh`, not `meshbox`,
	# for a real per-face UV instead of the disc mapping's stretch.
	mesh
		name walk
		vertex 385 -400 29
		vertex 400 -400 29
		vertex 400 400 29
		vertex 385 400 29
		vertex 385 -400 30
		vertex 400 -400 30
		vertex 400 400 30
		vertex 385 400 30
		texcoord -3.75 -200
		texcoord -3.75 200
		texcoord 3.75 200
		texcoord 3.75 -200
		texcoord -3.75 -200
		texcoord 3.75 -200
		texcoord 3.75 200
		texcoord -3.75 200
		texcoord -0.9375 0
		texcoord 0.9375 0
		texcoord 0.9375 0.125
		texcoord -0.9375 0.125
		texcoord -50 0
		texcoord 50 0
		texcoord 50 0.125
		texcoord -50 0.125
		texcoord 0.9375 0
		texcoord -0.9375 0
		texcoord -0.9375 0.125
		texcoord 0.9375 0.125
		texcoord 50 0
		texcoord -50 0
		texcoord -50 0.125
		texcoord 50 0.125
		face
			vertices 0 3 2 1
			texcoords 0 1 2 3
			matref seethrough
		endface
		face
			vertices 4 5 6 7
			texcoords 4 5 6 7
			matref concrete
		endface
		face
			vertices 0 1 5 4
			texcoords 8 9 10 11
			matref industrial
		endface
		face
			vertices 1 2 6 5
			texcoords 12 13 14 15
			texture caution
		endface
		face
			vertices 2 3 7 6
			texcoords 16 17 18 19
			matref industrial
		endface
		face
			vertices 3 0 4 7
			texcoords 20 21 22 23
			texture caution
		endface
	end

	# boxes for access
	box
		name n_edge
		position 400.0 180.0 0.0
		rotation 45.0
		size     30.0 30.0 15.0
		top matref concrete
		sides matref industrial
	end
	box
		name s_edge
		position 400.0 -180.0 0.0
		rotation 45.0
		size     30.0 30.0 15.0
		top matref concrete
		sides matref industrial
	end

	# box in the middle in front of the base
	box
		name mid
		position 200.0 0.0 0.0
		rotation 0.0
		size     30.0 30.0 15.0
		top matref concrete
		sides matref industrial
	end

	# pyramids under the base
	pyramid
		name pyr1
		position 340.0 -45.0 0.0
		rotation 0.0
		size     7.5 7.5 26.0
		sides matref strut
	end
	pyramid
		name pyr2
		position 340.0 45.0 0.0
		rotation 0.0
		size     7.5 7.5 26.0
		sides matref strut
	end
	pyramid
		name pyr3
		position 295.0 0.0 0.0
		rotation 0.0
		size     7.5 7.5 26.0
		sides matref strut
	end
	pyramid
		name pyr4
		position 385.0 0.0 0.0
		rotation 0.0
		size     7.5 7.5 26.0
		sides matref strut
	end
enddef

group cardinal_quadrant
	name e
	position 0.0 0.0 0.0
	rotation 0.0
end
group cardinal_quadrant
	name n
	position 0.0 0.0 0.0
	rotation 90.0
end
group cardinal_quadrant
	name w
	position 0.0 0.0 0.0
	rotation 180.0
end
group cardinal_quadrant
	name s
	position 0.0 0.0 0.0
	rotation 270.0
end

# The teleporter pair itself now lives once in `diag_quadrant` (see its
# own comment) and is instanced into all four corners by the group. A
# `link` block is not a group member upstream or in bzo -- neither
# engine renames or re-instances one per group copy -- so each corner's
# own pair still needs its own explicit links here, by its qualified
# name, in and out of every face.
link
	from ne:tele_low:f
	to ne:tele_high:f
end
link
	from ne:tele_low:b
	to ne:tele_high:b
end
link
	from ne:tele_high:f
	to ne:tele_low:f
end
link
	from ne:tele_high:b
	to ne:tele_low:b
end
link
	from sw:tele_low:f
	to sw:tele_high:f
end
link
	from sw:tele_low:b
	to sw:tele_high:b
end
link
	from sw:tele_high:f
	to sw:tele_low:f
end
link
	from sw:tele_high:b
	to sw:tele_low:b
end
link
	from se:tele_low:f
	to se:tele_high:f
end
link
	from se:tele_low:b
	to se:tele_high:b
end
link
	from se:tele_high:f
	to se:tele_low:f
end
link
	from se:tele_high:b
	to se:tele_low:b
end
link
	from nw:tele_low:f
	to nw:tele_high:f
end
link
	from nw:tele_low:b
	to nw:tele_high:b
end
link
	from nw:tele_high:f
	to nw:tele_low:f
end
link
	from nw:tele_high:b
	to nw:tele_low:b
end

# red base
base
	name n_red_base
	position 0.0 340.0 26.0
	rotation 45.0
	size 35.0 35.0 4.0
	color 1
end
# green base
base
	name e_green_base
	position 340.0 0.0 26.0
	rotation 45.0
	size 35.0 35.0 4.0
	color 2
end
# blue base
base
	name s_blue_base
	position 0.0 -340.0 26.0
	rotation 45.0
	size 35.0 35.0 4.0
	color 3
end
# purple base
base
	name w_purple_base
	position -340.0 0.0 26.0
	rotation 45.0
	size 35.0 35.0 4.0
	color 4
end
