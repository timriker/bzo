# HiX3 experimental world
# Copyright (c) 1993-2026 Tim Riker
# by Tim Riker <Tim@Rikers.org>
#
# This is a team play world

options
	# Team play, so the four coloured bases below are capture targets.
	-c
	# Per-team player limits, in BZFlag's team order:
	# rogue, observer, red, green, blue, purple.
	-mp 10,10,10,10,10,10
	# Superflags may spawn on, and come to rest on, the buildings.
	# With as much roof as this world has, the ground-only rule hides most of them.
	-fb
	# Tanks may jump. bzo has jumping on unless server.json turns it off,
	# so this is what turns it back on for this world.
	-j
	# Every shot ricochets, whatever flag fired it.
	+r
	# Five shots in the air at once, where bzfs gives one. The reload time
	# follows from it: a slot comes back after shotRange / shotSpeed / this.
	-ms 5
	# Superflag slots. Left off, this is 16; the world is 800 units across,
	# so it takes rather more than that to find one.
	-s 200
	# A bad flag falls off by itself after this many seconds.
	-st 50
	# A bad flag also falls off after this many kills.
	-sw 2
	# An antidote flag is put in the world for whoever is carrying a bad one,
	# which sheds it when they drive onto it.
	-sa
end

world
	name HiX 3.0
	size 400.0
	flagHeight 0.0
end

# One shared look for every box/mesh side on the map -- a bare `matref` sets
# both a plain box's wall and cap faces at once (docs/bzw.md, "Materials": no
# face selector reaches both groups) until something else overrides one of
# them, which is exactly what the `top matref concrete` lines below do.
# Retexturing every side site-wide is one edit here, not one per obstacle.
material
	name industrial
	addtexture http://images.bzflag.org/pmatous/Slate_flooring_2_more_color.png
end

# a metal texture distinct for struts
material
	name strut
	addtexture http://images.bzflag.org/bz_legacy/louman/thegauntlet/Metal5.png
end

# Every top -- box cap, octagon cap, walkway deck alike
material
	name concrete
	addtexture http://images.bzflag.org/pmatous/concrete-jigsaw-light.png
end

# The ground too -- see "Ground texture" in docs/bzw.md
material
	name GroundMaterial
	matref concrete
end

# barbed wire fence in use as metal grid on walkways to see up through
material
	name seethrough
	addtexture http://images.bzflag.org/gbratley/Spazzy%20McGee_fence-barbs.png
end

# top of the world
# Apothem 9.6568542495 and circumradius 10.4525037190
arc
	name totw
	position 0.0 0.0 29.0
	rotation -22.5
	size     10.4525037190 10.4525037190 16.0
	divisions 8
	matref industrial
	top matref concrete
	# arc's own disc/cap tile size defaults to -8 (1 tile per 8 units) same
	# as its outside wall -- a plain box's own cap tiles at 2 (`capScale`,
	# `BOX_TEXTURE_SCALES`, render.js), 4x denser. `du`/`dv` here override
	# just the disc, leaving `u`/`v` (the outside wall) at their own -8
	# default to match `sideScale`.
	texsize -8 -8 -2 -2
end

# Top of the World roof -- a real octagonal cone (`cone`, 8 divisions)
cone
	name totwr
	position 0.0 0.0 52.0
	rotation -22.5
	size     10.4525037190 10.4525037190 5.0
	divisions 8
	edge texture pyrwall
	bottom texture roof
end


# The support truss under each diagonal walkway's midpoint tower -- a
# vertical core spike, two crossed ribs, and two crossed cap pieces at the
# top, the caps flared up as an inverted bracket flush against the walkway's
# own underside (see the caps' own comment below for why). One instance sits
# at the inner ring, a second at the outer ring, further out along the same
# diagonal -- defined once here and instanced twice below rather than by
# hand at each radius.
define support
	pyramid
		name core
		position 0.0 0.0 0.0
		rotation 45.0
		size     2.0 2.0 18.0
		sides matref strut
	end
	pyramid
		name rib0
		position 0.0 0.0 0.0
		rotation 0.0
		size     8.0 1.0 5.0
		sides matref strut
	end
	pyramid
		name rib90
		position 0.0 0.0 0.0
		rotation 90.0
		size     8.0 1.0 5.0
		sides matref strut
	end
	# real inversion here needs literal `flipz` plus
	# a *non-negative* height. Flipped, `position.z` is the apex end and the
	# base lands at `position.z + height`: 12.0/2.0 puts the base flush at
	# 14.0, against the walkway's own underside (`plat1_ne`/`plat1_sw` both
	# start at z=14) -- an inverted bracket flaring up to meet the walkway
	# it holds up, tapering to a point below. `d`'s own sign (`-0.5`) still
	# matters: the flip step mirrors the mesh, and a second negative axis
	# cancels that mirror back to a proper rotation so faces stay correctly
	# wound and lit in a real client.
	pyramid
		name cap0
		position 0.0 0.0 12.0
		rotation 0.0
		size     8.0 -0.5 2.0
		flipz
		sides matref strut
	end
	pyramid
		name cap90
		position 0.0 0.0 12.0
		rotation 90.0
		size     8.0 -0.5 2.0
		flipz
		sides matref strut
	end
enddef

define diag_quadrant
	box
		name xwall
		position 180.0 180.0 14.0
		rotation 135.0
		size     0.5 150.0 15.0
		top matref concrete
		sides matref industrial
	end
	# internal end of the wall
	box
		name wallend1
		position 80.0 80.0 0.0
		rotation 0.0
		size     30.0 30.0 15.0
		top matref concrete
		sides matref industrial
	end
	# platform 1 cut out to fit between
	# wallend1 and oct
	mesh
		name plat1_ne
		vertex 199.313708 188 14
		vertex 261.313708 249.999 14
		vertex 249.999 249.999 14
		vertex 249.999 261.313708 14
		vertex 188 199.313708 14
		vertex 199.313708 188 15
		vertex 261.313708 249.999 15
		vertex 249.999 249.999 15
		vertex 249.999 261.313708 15
		vertex 188 199.313708 15
		texcoord 94 99.656854
		texcoord 124.9995 130.656854
		texcoord 124.9995 124.9995
		texcoord 130.656854 124.9995
		texcoord 99.656854 94
		texcoord 99.656854 94
		texcoord 130.656854 124.9995
		texcoord 124.9995 124.9995
		texcoord 124.9995 130.656854
		texcoord 94 99.656854
		texcoord 0 0
		texcoord 10.960067 0
		texcoord 10.960067 0.125
		texcoord 0 0.125
		texcoord 10.960067 0
		texcoord 12.374405 0
		texcoord 12.374405 0.125
		texcoord 10.960067 0.125
		texcoord 12.374405 0
		texcoord 13.788744 0
		texcoord 13.788744 0.125
		texcoord 12.374405 0.125
		texcoord 13.788744 0
		texcoord 24.748811 0
		texcoord 24.748811 0.125
		texcoord 13.788744 0.125
		texcoord 24.748811 0
		texcoord 26.748811 0
		texcoord 26.748811 0.125
		texcoord 24.748811 0.125
		face
			vertices 4 3 2 1 0
			texcoords 0 1 2 3 4
			matref seethrough
		endface
		face
			vertices 5 6 7 8 9
			texcoords 5 6 7 8 9
			matref concrete
		endface
		face
			vertices 0 1 6 5
			texcoords 10 11 12 13
			texture caution
		endface
		face
			vertices 1 2 7 6
			texcoords 14 15 16 17
			matref industrial
		endface
		face
			vertices 2 3 8 7
			texcoords 18 19 20 21
			matref industrial
		endface
		face
			vertices 3 4 9 8
			texcoords 22 23 24 25
			texture caution
		endface
		face
			vertices 4 0 5 9
			texcoords 26 27 28 29
			matref industrial
		endface
	end
	# octagon under the wall
	# a real octagon (`arc`, 8 divisions), apothem
	# 19.3137084990, circumradius 20.9050074380
	arc
		name oct
		position 180.0 180.0 0.0
		rotation -22.5
		size     20.9050074380 20.9050074380 15.0
		divisions 8
		matref industrial
		top matref concrete
		# Same fix as "top of the world" above -- see its own comment.
		texsize -8 -8 -2 -2
	end
	# more platform 1 fitting up against
	# oct and wallend 2
	mesh
		name plat1_sw
		vertex 160.686292 172 14
		vertex 98.686292 110.001 14
		vertex 110.001 110.001 14
		vertex 110.001 98.686292 14
		vertex 172 160.686292 14
		vertex 160.686292 172 15
		vertex 98.686292 110.001 15
		vertex 110.001 110.001 15
		vertex 110.001 98.686292 15
		vertex 172 160.686292 15
		texcoord 86 80.343146
		texcoord 55.0005 49.343146
		texcoord 55.0005 55.0005
		texcoord 49.343146 55.0005
		texcoord 80.343146 86
		texcoord 80.343146 86
		texcoord 49.343146 55.0005
		texcoord 55.0005 55.0005
		texcoord 55.0005 49.343146
		texcoord 86 80.343146
		texcoord 0 0
		texcoord 10.960067 0
		texcoord 10.960067 0.125
		texcoord 0 0.125
		texcoord 10.960067 0
		texcoord 12.374405 0
		texcoord 12.374405 0.125
		texcoord 10.960067 0.125
		texcoord 12.374405 0
		texcoord 13.788744 0
		texcoord 13.788744 0.125
		texcoord 12.374405 0.125
		texcoord 13.788744 0
		texcoord 24.748811 0
		texcoord 24.748811 0.125
		texcoord 13.788744 0.125
		texcoord 24.748811 0
		texcoord 26.748811 0
		texcoord 26.748811 0.125
		texcoord 24.748811 0.125
		face
			vertices 4 3 2 1 0
			texcoords 0 1 2 3 4
			matref seethrough
		endface
		face
			vertices 5 6 7 8 9
			texcoords 5 6 7 8 9
			matref concrete
		endface
		face
			vertices 0 1 6 5
			texcoords 10 11 12 13
			texture caution
		endface
		face
			vertices 1 2 7 6
			texcoords 14 15 16 17
			matref industrial
		endface
		face
			vertices 2 3 8 7
			texcoords 18 19 20 21
			matref industrial
		endface
		face
			vertices 3 4 9 8
			texcoords 22 23 24 25
			texture caution
		endface
		face
			vertices 4 0 5 9
			texcoords 26 27 28 29
			matref industrial
